# Local development only. Set real addresses and SMTP before use with customers.
DATABASE_URL=postgres://brunch:brunch-local@127.0.0.1:55434/brunch
BIND_ADDR=127.0.0.1:3100
PUBLIC_URL=http://127.0.0.1:3100
ADMIN_EMAIL=admin@example.test
ORDER_EMAIL=orders@example.test
SMTP_FROM=brunch@example.test
SMTP_HOST=127.0.0.1
SMTP_PORT=11026
SMTP_TLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
DIST_DIR=dist
POSTGRES_PASSWORD=brunch-local

# Expire unpaid online orders after this many minutes (1..1440, default 60).
# Saved deadlines do not change when this setting changes.
ONLINE_PAYMENT_TIMEOUT_MINUTES=60

# Teya Hosted Checkout is disabled until an environment is selected.
# Never place client secrets in this file or in public/dist. See docs/teya-payments.md.
# Use staging first, then production with separate credentials and database.
TEYA_ENVIRONMENT=
TEYA_STORE_ID=
TEYA_CLIENT_ID=
TEYA_CLIENT_SECRET_FILE=
TEYA_WEBHOOK_PUBLIC_KEY_FILE=
TEYA_WEBHOOK_PREVIOUS_PUBLIC_KEY_FILE=
