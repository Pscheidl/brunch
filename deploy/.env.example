# Copy to /etc/brunch/brunch.env, owned by root, mode 0600.
# This is a Docker Compose env file, never source it as a shell script.
# Use single quotes around SMTP passwords containing $, # or spaces.
COMPOSE_PROJECT_NAME=brunch-production
APP_ENV=production
BRUNCH_IMAGE=brunch:REPLACE_WITH_RELEASE_TAG
DOMAIN=shop.example.invalid
ACME_EMAIL=admin@example.invalid
# Public IPv4 HTTPS requires both explicit opt-in and short-lived certificates.
# Keep false/classic for the ordinary domain-based deployment.
ALLOW_PUBLIC_IP=false
ACME_PROFILE=classic

# Two DIFFERENT random passwords, each generated with: openssl rand -hex 32
# Changing these values does not rotate credentials in an existing database.
POSTGRES_ADMIN_PASSWORD=REPLACE_WITH_64_HEX_CHARACTERS
POSTGRES_PASSWORD=REPLACE_WITH_DIFFERENT_64_HEX_CHARACTERS

# Initial recipient only. Later change in the shop administration.
ORDER_EMAIL=orders@example.invalid
SMTP_FROM=shop@example.invalid
SMTP_HOST=smtp.example.invalid
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Alternative to SMTP_PASSWORD. Do not set both.
# SMTP_PASSWORD_FILE=/run/brunch-secrets/smtp-password
SMTP_PASSWORD_FILE=
SECRETS_DIR=/etc/brunch/secrets

ONLINE_PAYMENT_TIMEOUT_MINUTES=60
# Empty disables online payments. Cash and card terminal at delivery still work.
# For staging use APP_ENV=staging and a separate database/server.
TEYA_ENVIRONMENT=
TEYA_STORE_ID=
TEYA_CLIENT_ID=
TEYA_CLIENT_SECRET_FILE=
TEYA_WEBHOOK_PUBLIC_KEY_FILE=
TEYA_WEBHOOK_PREVIOUS_PUBLIC_KEY_FILE=
# When ready, paths INSIDE the app container are:
# TEYA_CLIENT_SECRET_FILE=/run/brunch-secrets/teya-client-secret
# TEYA_WEBHOOK_PUBLIC_KEY_FILE=/run/brunch-secrets/teya-webhook-public.pem
# TEYA_WEBHOOK_PREVIOUS_PUBLIC_KEY_FILE=/run/brunch-secrets/teya-webhook-previous.pem
